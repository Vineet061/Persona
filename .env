# --- Model Configuration ---
modelNewweight="models/updated.weights.h5"

# JSON list of class names
imgClasses=["AADHAAR", "UNKNOWN", "PAN", "DRIVING LICENCE"]
# JSON mapping of labels for extraction
labelList = ["uid","dob","name","gender"]

# Local model paths
model="model_weights.h5"
detectionPath="best.pt"
localizationPath="localization.pt"

# --- Server Configuration ---
portNum=9988
# Path to Tesseract executable (Windows specific example)
tesseractPath="C:/Program Files/Tesseract-OCR/tesseract.exe"
# Path to Poppler bin (Windows specific example)
POPPLER_PATH="poppler-23.11.0/Library/bin"

# --- Retraining (Legacy/Unused) ---
# Main dataset directory
mainDsDir="DS"
trainDir="Train_Data"
augFolderName="Train_curr_img"
classUpdatedName="cls_name.json"

croppedImage = "cropped_img.png"
imgPath = "1.jpg"
imgBBPath = "imgBB/1.png"
foldPath = "imgBB/"
rawImage = "copy.png"
foldBB = "imgBB"
trainHour = "12"
trainMin = "20"






